# Copy this file to .env and edit values to swap models/providers without
# touching any code. Every value here has a working default already baked
# into config.js, so an empty/missing .env behaves exactly like before.

# Base URL of the LLM API. For local Ollama, leave as-is. To point at a
# hosted OpenAI-compatible provider instead, change this to that provider's
# base URL (note: this project's request/response parsing assumes Ollama's
# /api/chat shape - a genuinely different provider's response format would
# need a small adapter, not just a URL change).
LLM_BASE_URL=http://localhost:11434

# Which chat model to use. Must already be pulled locally (`ollama pull <name>`)
# if using local Ollama.
CHAT_MODEL=qwen3-coder:30b

# Which embedding model to use for RAG (must also be pulled locally).
EMBED_MODEL=nomic-embed-text

# Context window size passed to Ollama (see agent.js for why this must be
# set explicitly rather than relying on Ollama's own default).
NUM_CTX=32768

# Sampling temperature. 0 = deterministic/greedy (recommended for this
# project's tool-calling and RAG use case - see Phase 6.8/7's lessons about
# why higher temperature made tool-choice unreliable).
TEMPERATURE=0

# pgvector cosine-distance cutoff below which a retrieved chunk is treated
# as relevant (see agent.js for how this threshold was measured).
RELEVANCE_THRESHOLD=0.5

# Only needed for a hosted provider that requires authentication. Leave
# unset for local Ollama (no auth required).
LLM_API_KEY=
