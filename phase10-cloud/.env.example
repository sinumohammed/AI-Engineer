# Copy this file to .env and edit values to swap models/providers without
# touching any code. Every value here has a working default already baked
# into api/config.js, so an empty/missing .env behaves exactly like before.

# --- Chat model provider (Phase 10) ---
# ollama = local Ollama (default). groq = Groq, with GROQ_API_KEY below.
# openai = any other OpenAI-compatible API: set LLM_BASE_URL (with /v1) and LLM_API_KEY.
LLM_PROVIDER=ollama

# Which chat model to use - must exist on the provider above.
# ollama: a pulled model, e.g. qwen3-coder:30b
# groq:   openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b (list: GET /openai/v1/models)
CHAT_MODEL=qwen3-coder:30b

# Optional: separate models for the smaller jobs. All default to CHAT_MODEL.
# JUDGE_MODEL: judges which excerpts answer the question, rewrites follow-ups.
# ROUTER_MODEL / SPECIALIST_MODEL: the supervisor's router and specialists.
# On Groq each model has its own daily quota, so e.g. answers on
# openai/gpt-oss-120b and JUDGE_MODEL=ROUTER_MODEL=openai/gpt-oss-20b.
# JUDGE_MODEL=
# ROUTER_MODEL=
# SPECIALIST_MODEL=

# Base URL of the chat API for ollama and openai (groq has it built in).
LLM_BASE_URL=http://localhost:11434

# Key for LLM_PROVIDER=openai. Leave empty for local Ollama.
LLM_API_KEY=

# Key for LLM_PROVIDER=groq, from https://console.groq.com/keys. Never commit it.
GROQ_API_KEY=

# gpt-oss models only: how long they think before answering (low | medium | high).
# Unset = the provider's default.
# REASONING_EFFORT=low

# --- Embeddings ---
# ollama (default), local or gemini. Groq has no embedding model.
# local = the same nomic model inside the Node process (no service, no quota);
#   EMBED_LOCAL_DTYPE=q8 (default, fits a Vercel function), fp16 or fp32.
# gemini = Google's API; free tier only 1,000 texts a day.
# Questions must be embedded by the same model as the table being searched -
# search refuses a mismatch. Private documents are only ingested when both the
# embedding and the database are on this machine (scripts/ingest.js).
EMBED_PROVIDER=ollama
# EMBED_LOCAL_DTYPE=q8
# Ollama's embedding server and model.
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Key for EMBED_PROVIDER=gemini, from https://aistudio.google.com. Never commit it.
# Free tier: 100 texts a minute. GEMINI_EMBED_MODEL defaults to gemini-embedding-001.
GEMINI_API_KEY=

# The chunk table search reads: doc_chunks (Ollama embeddings) or a table made
# by e.g. EMBED_PROVIDER=local INGEST_TABLE=chunks_local_q8 npm run ingest.
# DOCS_TABLE=doc_chunks

# --- Where the data lives (Phase 10 step 3) ---
# Defaults are the local Docker containers. Neon and Upstash give URLs in this
# form (Upstash's starts with rediss:// - TLS). They contain passwords: never commit.
# DATABASE_URL=postgres://rag:rag@localhost:5432/rag
# REDIS_URL=redis://localhost:6379
# The hosted ones, kept under other names so the app does not switch to them
# by accident; a run uses them with DATABASE_URL="$NEON_DATABASE_URL" etc.
# Neon: the pooled connection string (host contains -pooler).
# NEON_DATABASE_URL=postgresql://...-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Upstash: the TCP URL (rediss://), not the REST URL.
# UPSTASH_REDIS_URL=rediss://default:...@....upstash.io:6379

# Where the web app finds the API. Default http://localhost:3002. Empty = the
# same site as the page. Read when the web app starts/builds, not per request.
# Only VITE_* values here reach the browser.
# VITE_API_BASE=http://localhost:3002

# Traces: file (api/logs/traces.jsonl) or console. Default: console on Vercel, file elsewhere.
# TRACE_TO=file

# --- Model settings ---
# Context window size passed to Ollama (see agent.js for why this must be
# set explicitly rather than relying on Ollama's own default). Hosted
# providers set their own; there it is only the limit the UI's token ring shows.
NUM_CTX=32768

# Sampling temperature. 0 = deterministic/greedy (recommended for this
# project's tool-calling and RAG use case - see Phase 6.8/7's lessons about
# why higher temperature made tool-choice unreliable).
TEMPERATURE=0

# pgvector cosine-distance cutoff, used only with RERANK=0 (the Phase 7
# threshold); by default the model judges relevance (Phase 9.4).
RELEVANCE_THRESHOLD=0.5
